            ]"
            :style="{ backgroundColor: color }"
            :title="color"
          ></button>
          
          <!-- Divider -->
          <div class="w-px h-6 bg-gray-600 mx-2"></div>
          
          <!-- Pen Size -->
          <div class="flex items-center space-x-2">
            <label class="text-xs text-gray-300">Size</label>
            <input
              type="range"
              min="1"
              max="10"
              v-model="screen2PenSize"
              class="w-16 h-4"
            />
            <span class="text-xs text-gray-300 w-6 text-center">{{ screen2PenSize }}</span>
          </div>
          
          <!-- Clear Drawing -->
          <button
            @click="screen2PresentationDrawings = []"
            class="p-1 text-gray-400 hover:text-red-400 hover:bg-red-900/30 rounded transition-colors"
            title="Clear Drawing"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </button>
        </div>

        <div
