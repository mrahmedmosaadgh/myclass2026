              d="M8 7h8m-4-4v8m0 0l3-3m-3 3L5 8m12 8l-3-3m3 3l-3 3m-5-3h8"
            ></path>
            <path 
              v-else
              stroke-linecap="round" 
              stroke-linejoin="round" 
              stroke-width="2" 
              d="M7 8v8m-4-4h8m0 0l-3-3m3 3l-3 3m12-3l-3-3m3 3l-3 3m-3-5v8"
            ></path>
          </svg>
        </button>

        <!-- Drawing Tool -->
        <button
