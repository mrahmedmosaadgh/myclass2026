          :class="[
            'w-10 h-10 rounded-full flex items-center justify-center transition-colors',
            screen1DrawingMode
              ? 'bg-blue-600 hover:bg-blue-700 text-white'
              : 'bg-white/20 hover:bg-white/30 text-white'
          ]"
