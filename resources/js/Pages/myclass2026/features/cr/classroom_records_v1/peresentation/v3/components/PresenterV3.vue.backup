            width: (splitDirection === 'horizontal' ? 50% : slideWidth * 0.7) + 'px', 
            maxHeight: splitDirection === 'horizontal' ? '75vh' : '35vh',
            overflowY: 'auto',
            transform: `scale(${splitDirection === 'horizontal' ? 0.9 : 0.7})`
          }"
        >
          <div
            class="relative"
            :style="{ height: slideHeight + 'px' }"
          >
            <!-- Drawing Elements -->
            <svg
              v-if="screen2DrawingElements.length > 0"
              class="absolute inset-0 pointer-events-none"
              :style="{ width: slideWidth + 'px', height: slideHeight + 'px', zIndex: 999 }"
            >
              <defs>
                <rect
                  id="drawing-clip"
                  :width="slideWidth"
                  :height="slideHeight"
                />
              </defs>
              <g clip-path="url(#drawing-clip)">
                <path
                  v-for="element in screen2DrawingElements"
                  :key="element.id"
                  :d="element.path"
                  :stroke="element.color"
                  :stroke-width="element.size"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </g>
            </svg>
            
            <div
