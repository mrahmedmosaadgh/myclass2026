                v-else-if="element.type === 'image'"
                :src="element.src"
                class="w-full h-full object-cover"
                draggable="false"
              />

              <!-- Rectangle Elements -->
              <div
                v-else-if="element.type === 'rectangle'"
                class="w-full h-full cursor-pointer"
                :style="getRectangleStyle(element)"
              ></div>
            </div>
          </div>
          
          <!-- Drawing Overlay for Screen 2 -->
          <div
