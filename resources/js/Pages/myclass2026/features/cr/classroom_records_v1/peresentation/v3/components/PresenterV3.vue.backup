      >
        <!-- Color Picker -->
        <input
          type="color"
          :value="penColor"
          @input="handleColorChange"
          class="w-8 h-8 border-2 border-gray-600 rounded cursor-pointer"
          title="Pen Color"
        />
        
        <!-- Quick Colors -->
        <button
          v-for="color in quickColors"
