          </svg>
        </button>
      </div>
      
      <div class="bg-gray-900/90 backdrop-blur-md border border-gray-700 rounded-full px-6 py-3 flex items-center space-x-4 shadow-2xl">
        <!-- Split Screen Controls -->
        <button
