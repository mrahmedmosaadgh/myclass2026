<template>
  <div class="h-full bg-gray-900 flex">
    <!-- Single Screen Mode -->
    <div 
      v-if="!splitScreenMode"
      class="flex-1 h-full flex items-center justify-center p-8"
    >
      <div
        class="bg-white shadow-2xl relative"
        :style="{ width: slideWidth + 'px', maxHeight: '80vh', overflowY: 'auto' }"
      >
        <!-- Current Slide -->
        <div
          class="relative"
          :style="{ height: slideHeight + 'px' }"
        >
          <!-- Drawing Elements -->
          <svg
            v-if="drawingElements.length > 0"
            class="absolute inset-0 pointer-events-none"
            :style="{ width: slideWidth + 'px', height: slideHeight + 'px', zIndex: 999 }"
          >
            <defs>
              <rect
                id="drawing-clip"
                :width="slideWidth"
                :height="slideHeight"
              />
            </defs>
            <g clip-path="url(#drawing-clip)">
              <path
                v-for="element in drawingElements"
                :key="element.id"
                :d="element.path"
                :stroke="element.color"
                :stroke-width="element.size"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </g>
          </svg>
          
          <div
            v-for="element in currentSlide.elements"
            :key="element.id"
            class="absolute"
            :style="getElementStyle(element)"
            @click.stop="handleElementClick(element)"
            @mousedown="startDrag(element, $event)"
          >
            <!-- Text Elements -->
            <div
              v-if="element.type === 'text' || element.type === 'heading' || element.type === 'subheading'"
              :style="getTextStyle(element)"
            >
              {{ element.content }}
            </div>

            <!-- Image Elements -->
            <img
              v-else-if="element.type === 'image'"
              :src="element.src"
              class="w-full h-full object-cover"
              draggable="false"
            />

            <!-- Rectangle Elements -->
            <div
              v-else-if="element.type === 'rectangle'"
              class="w-full h-full cursor-pointer"
              :style="getRectangleStyle(element)"
            ></div>
          </div>
        </div>
        
        <!-- Drawing Overlay for Presentation -->
        <div
          v-if="isDrawingMode"
          class="absolute inset-0 cursor-crosshair"
          :style="{ width: slideWidth + 'px', height: slideHeight + 'px', zIndex: 1000 }"
          @mousedown="startDrawing"
          @mousemove="draw"
          @mouseup="stopDrawing"
          @mouseleave="stopDrawing"
        >
          <!-- Live drawing preview -->
          <svg
            class="absolute inset-0 pointer-events-none"
            :style="{ width: slideWidth + 'px', height: slideHeight + 'px' }"
          >
            <defs>
              <rect
                id="drawing-clip"
                :width="slideWidth"
                :height="slideHeight"
              />
            </defs>
            <g clip-path="url(#drawing-clip)">
              <!-- Current drawing path -->
              <path
                v-if="currentPath"
                :d="currentPath.d"
                :stroke="currentPath.color"
                :stroke-width="currentPath.size"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </g>
          </svg>
        </div>
      </div>
    </div>

    <!-- Split Screen Mode -->
    <div 
      v-else
      class="flex-1 h-full"
      :class="splitDirection === 'horizontal' ? 'flex-row' : 'flex-col'"
    >
      <!-- First Screen -->
      <div class="flex-1 flex items-center justify-center p-4 border-gray-700"
           :class="splitDirection === 'horizontal' ? 'border-r' : 'border-b'">
        <!-- Screen 1 Navigation -->
        <div class="absolute top-4 left-4 z-[1100] bg-gray-900/90 backdrop-blur-md border border-gray-700 rounded-full px-3 py-2 flex items-center space-x-2">
          <button
            @click="screen1SlideIndex.value = Math.max(0, screen1SlideIndex.value - 1)"
            class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors"
            title="Previous Slide"
          >
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          
          <span class="text-white text-sm font-medium min-w-[3ch] text-center">{{ screen1SlideIndex + 1 }}</span>
          
          <button
            @click="screen1SlideIndex.value = Math.min(props.slides.length - 1, screen1SlideIndex.value + 1)"
            class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors"
            title="Next Slide"
          >
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>

        <!-- Screen 1 Drawing Toolbar -->
        <div
          v-if="screen1DrawingMode"
          class="absolute top-16 left-4 z-[1100] bg-gray-900 rounded-xl shadow-2xl p-3 flex items-center space-x-3"
        >
          <!-- Color Picker -->
          <input
            type="color"
            :value="screen1PenColor"
            @input="screen1PenColor = $event.target.value"
            class="w-8 h-8 border-2 border-gray-600 rounded cursor-pointer"
            title="Pen Color"
          />
          
          <!-- Quick Colors -->
          <button
            v-for="color in quickColors"
            :key="color"
            @click="screen1PenColor = color"
            :class="[
              'w-6 h-6 rounded border-2 transition-all',
              screen1PenColor === color ? 'border-white scale-110' : 'border-gray-600 hover:border-gray-400'
            ]"
            :style="{ backgroundColor: color }"
            :title="color"
          ></button>
          
          <!-- Divider -->
          <div class="w-px h-6 bg-gray-600 mx-2"></div>
          
          <!-- Pen Size -->
          <div class="flex items-center space-x-2">
            <label class="text-xs text-gray-300">Size</label>
            <input
              type="range"
              min="1"
              max="10"
              v-model="screen1PenSize"
              class="w-16 h-4"
            />
            <span class="text-xs text-gray-300 w-6 text-center">{{ screen1PenSize }}</span>
          </div>
          
          <!-- Clear Drawing -->
          <button
            @click="screen1PresentationDrawings = []"
            class="p-1 text-gray-400 hover:text-red-400 hover:bg-red-900/30 rounded transition-colors"
            title="Clear Drawing"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </button>
        </div>

        <div
          class="bg-white shadow-2xl relative"
          :style="{ 
            width: (splitDirection === 'horizontal' ? 50% : slideWidth * 0.7) + 'px', 
            maxHeight: splitDirection === 'horizontal' ? '75vh' : '35vh',
            overflowY: 'auto',
            transform: `scale(${splitDirection === 'horizontal' ? 0.9 : 0.7})`
          }"
        >
          <div
            class="relative"
            :style="{ height: slideHeight + 'px' }"
          >
            <!-- Drawing Elements -->
            <svg
              v-if="screen1DrawingElements.length > 0"
              class="absolute inset-0 pointer-events-none"
              :style="{ width: slideWidth + 'px', height: slideHeight + 'px', zIndex: 999 }"
            >
              <defs>
                <rect
                  id="drawing-clip"
                  :width="slideWidth"
                  :height="slideHeight"
                />
              </defs>
              <g clip-path="url(#drawing-clip)">
                <path
                  v-for="element in screen1DrawingElements"
                  :key="element.id"
                  :d="element.path"
                  :stroke="element.color"
                  :stroke-width="element.size"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </g>
            </svg>
            
            <div
              v-for="element in screen1Slide.elements"
              :key="element.id"
              class="absolute"
              :style="getElementStyle(element)"
              @click.stop="handleElementClick(element, 1)"
            >
              <!-- Text Elements -->
              <div
                v-if="element.type === 'text' || element.type === 'heading' || element.type === 'subheading'"
                :style="getTextStyle(element)"
              >
                {{ element.content }}
              </div>

              <!-- Image Elements -->
              <img
                v-else-if="element.type === 'image'"
                :src="element.src"
                class="w-full h-full object-cover"
                draggable="false"
              />

              <!-- Rectangle Elements -->
              <div
                v-else-if="element.type === 'rectangle'"
                class="w-full h-full cursor-pointer"
                :style="getRectangleStyle(element)"
              ></div>
            </div>
          </div>
          
          <!-- Drawing Overlay for Screen 1 -->
          <div
            v-if="screen1DrawingMode"
            class="absolute inset-0 cursor-crosshair"
            :style="{ width: slideWidth + 'px', height: slideHeight + 'px', zIndex: 1000 }"
            @mousedown="startDrawing(1, $event)"
            @mousemove="draw(1, $event)"
            @mouseup="stopDrawing(1)"
            @mouseleave="stopDrawing(1)"
          >
            <!-- Live drawing preview -->
            <svg
              class="absolute inset-0 pointer-events-none"
              :style="{ width: slideWidth + 'px', height: slideHeight + 'px' }"
            >
              <defs>
                <rect
                  id="drawing-clip"
                  :width="slideWidth"
                  :height="slideHeight"
                />
              </defs>
              <g clip-path="url(#drawing-clip)">
                <!-- Current drawing path -->
                <path
                  v-if="screen1CurrentPath"
                  :d="screen1CurrentPath.d"
                  :stroke="screen1CurrentPath.color"
                  :stroke-width="screen1CurrentPath.size"
