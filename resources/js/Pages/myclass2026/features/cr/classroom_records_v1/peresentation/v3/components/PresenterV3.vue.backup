              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          
          <span class="text-white text-sm font-medium min-w-[3ch] text-center">{{ screen2SlideIndex + 1 }}</span>
          
          <button
