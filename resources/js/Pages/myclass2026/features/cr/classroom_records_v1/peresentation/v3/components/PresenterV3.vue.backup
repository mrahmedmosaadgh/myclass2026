              :style="getElementStyle(element)"
              @click.stop="handleElementClick(element, 2)"
            >
              <!-- Text Elements -->
              <div
                v-if="element.type === 'text' || element.type === 'heading' || element.type === 'subheading'"
                :style="getTextStyle(element)"
              >
                {{ element.content }}
              </div>

              <!-- Image Elements -->
