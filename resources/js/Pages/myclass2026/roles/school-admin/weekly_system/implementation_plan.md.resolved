### 4 – Routes ([routes/weekly_system.php](file:///Users/ahmedmosaad/Herd/myclass2026-main/routes/weekly_system.php))

> [!NOTE]
> The `/lesson-plans/progress` static route MUST be declared **before** `/lesson-plans/{id}` to avoid Laravel matching `"progress"` as an ID.

Add inside the existing `prefix('weekly-system')` group:

```php
use App\Http\Controllers\WeeklySystem\CurriculumController;
use App\Http\Controllers\WeeklySystem\LessonPlanController;

// ─── ADMIN PAGES ───────────────────────────────────────────
Route::get('/', fn() => Inertia::render(
    'myclass2026/roles/school-admin/weekly_system/Index'
))->name('index');

Route::get('/curriculum-lessons', fn() => Inertia::render(
    'myclass2026/roles/school-admin/weekly_system/curriculum_lessons/Index'
))->name('curriculum-lessons.index');

// ─── TEACHER PAGES ─────────────────────────────────────────
Route::get('/teacher-curriculum-lessons', fn() => Inertia::render(
    'myclass2026/roles/teacher/weekly_system/curriculum_lessons/Index'
))->name('teacher.curriculum-lessons.index');

// ─── API ──────────────────────────────────────────────────
Route::prefix('api')->name('api.')->group(function () {
    // Curricula
    Route::get('/curriculum',          [CurriculumController::class, 'index'])->name('curriculum.index');
    Route::post('/curriculum',         [CurriculumController::class, 'store'])->name('curriculum.store'); // Admin only
    Route::put('/curriculum/{id}',     [CurriculumController::class, 'update'])->name('curriculum.update'); // Admin sets lock date
    Route::delete('/curriculum/{curriculum}', [CurriculumController::class, 'destroy'])->name('curriculum.destroy'); // Admin only

    // Lesson Plans — progress route FIRST (before {id} to avoid conflict)
    Route::get('/lesson-plans/progress',[LessonPlanController::class, 'progress'])->name('lesson-plans.progress'); // Admin: compare all school teachers vs submissions
    Route::get('/lesson-plans',        [LessonPlanController::class, 'index'])->name('lesson-plans.index');
    Route::post('/lesson-plans',       [LessonPlanController::class, 'store'])->name('lesson-plans.store');
    Route::put('/lesson-plans/{id}',   [LessonPlanController::class, 'update'])->name('lesson-plans.update');
    Route::delete('/lesson-plans/{id}',[LessonPlanController::class, 'destroy'])->name('lesson-plans.destroy');
});
```

